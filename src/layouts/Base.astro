---
interface Props {title?:string; description?:string; canonical?:string; image?:string; article?:boolean; published?:string; updated?:string; noindex?:boolean}
const {title='NISHAT INFO HUB',description='বাংলায় প্রযুক্তি, সরকারি চাকরি, দাপ্তরিক তথ্য ও ব্যবহারিক নির্দেশনা',canonical,image="/og-image.png",article=false,published,updated,noindex=false}=Astro.props;
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import {categories} from '../data/categories';
const url=canonical || new URL(Astro.url.pathname,Astro.site).toString();
---
<!doctype html><html lang="bn"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#10243b"/><link rel="canonical" href={url}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content={article ? "article" : "website"}/><meta property="og:url" content={url}/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><meta property="og:locale" content="bn_BD"/><meta property="og:site_name" content="NISHAT INFO HUB"/><meta property="og:image" content={new URL(image,Astro.site).href}/><meta name="twitter:card" content="summary_large_image"/>{noindex && <meta name="robots" content="noindex, follow"/>}{published && <meta property="article:published_time" content={published}/>}<script type="application/ld+json" set:html={JSON.stringify(article ? {'@context':'https://schema.org','@type':'Article',headline:title,description,datePublished:published,dateModified:updated||published,mainEntityOfPage:url,image:new URL(image,Astro.site).href,publisher:{'@type':'Organization',name:'NISHAT INFO HUB'}} : {'@context':'https://schema.org','@type':'WebSite',name:'NISHAT INFO HUB',url:Astro.site, inLanguage:'bn'}).replace(/</g,'\\u003c')}/><ClientRouter/><script is:inline data-astro-rerun>try{const t=localStorage.getItem('nishat-theme');document.documentElement.classList.toggle('dark',t==='dark'||(!t&&matchMedia('(prefers-color-scheme: dark)').matches))}catch{document.documentElement.classList.toggle('dark',matchMedia('(prefers-color-scheme: dark)').matches)}</script><title>{title}</title></head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased"><a class="skip-link" href="#main-content">মূল লেখায় যান</a><div id="logo-intro" aria-hidden="true"><div class="intro-mark">N<span>.</span></div><strong>NISHAT INFO HUB</strong><span>তথ্য জানুন, এগিয়ে থাকুন</span></div><div class="bg-navy text-white text-xs"><div class="max-w-6xl mx-auto px-4 py-2 flex justify-between"><span>প্রযুক্তি • চাকরি • দাপ্তরিক সমাধান</span><span>স্বাধীন তথ্য ও শিক্ষামূলক প্ল্যাটফর্ম</span></div></div>
<header class="bg-white sticky top-0 z-20 border-b border-slate-200"><div class="max-w-6xl mx-auto px-4 py-4 flex flex-wrap items-center justify-between gap-4"><a href="/" class="flex items-center gap-3" aria-label="NISHAT INFO HUB হোম"><span class="bg-navy text-white rounded-xl p-3 font-bold text-xl">N<span class="text-cyan-400">.</span></span><span class="leading-tight"><strong class="text-xl text-navy tracking-tight">NISHAT <span class="text-cyan">INFO HUB</span></strong><small class="block text-slate-500">তথ্য জানুন, এগিয়ে থাকুন</small></span></a><button id="theme-toggle" type="button" aria-label="ডার্ক মোড চালু করুন" aria-pressed="false" class="theme-button">◐ <span class="sr-only">রঙের মোড</span></button><nav class="hidden md:flex gap-4 flex-wrap text-sm font-semibold" aria-label="প্রধান নেভিগেশন"><a href="/">হোম</a><a href="/articles/">সব লেখা</a><a href="/categories/">বিভাগ</a><a href="/about/">আমাদের সম্পর্কে</a><a href="/contact/">যোগাযোগ</a></nav><details class="md:hidden relative"><summary class="cursor-pointer list-none border rounded-lg px-3 py-2 font-bold text-sm" aria-label="মেনু খুলুন">☰ মেনু</summary><nav aria-label="মোবাইল নেভিগেশন" class="absolute right-0 top-full mt-2 bg-white shadow-xl border border-slate-200 rounded-xl p-4 min-w-48 flex flex-col gap-3 text-sm font-semibold"><a href="/">হোম</a><a href="/articles/">সব লেখা</a><a href="/categories/">বিভাগ</a><a href="/about/">আমাদের সম্পর্কে</a><a href="/contact/">যোগাযোগ</a></nav></details></div></header>
<main id="main-content" tabindex="-1"><slot/></main><footer class="mt-16 bg-navy text-white"><div class="max-w-6xl mx-auto px-4 py-12 grid md:grid-cols-3 gap-8"><div><strong class="text-xl">NISHAT INFO HUB</strong><p class="mt-3 text-slate-300 text-sm">বাংলা ভাষায় সহজ ও ব্যবহারিক তথ্যের একটি স্বাধীন প্ল্যাটফর্ম। কোনো সরকারি সংস্থার অফিসিয়াল ওয়েবসাইট নয়।</p></div><div><strong>জনপ্রিয় বিভাগ</strong><div class="grid grid-cols-2 gap-2 mt-3 text-sm text-slate-300">{categories.slice(0,6).map(c=><a href={'/articles/?category='+encodeURIComponent(c)}>{c}</a>)}</div></div><div><strong>প্রয়োজনীয় পেজ</strong><div class="flex flex-col gap-2 mt-3 text-sm text-slate-300"><a href="/privacy/">গোপনীয়তা নীতি</a><a href="/editorial/">সম্পাদনা নীতি</a><a href="/disclaimer/">দায়বদ্ধতা অস্বীকার</a><a href="/contact/">যোগাযোগ</a></div></div></div><div class="border-t border-white/10 text-center text-slate-400 text-xs py-4">© {new Date().getFullYear()} NISHAT INFO HUB · সকল অধিকার সংরক্ষিত</div></footer><script src="../scripts/site.ts"></script></body></html>
