---
import Base from '../../layouts/Base.astro';import {render} from 'astro:content';import {publishedArticles} from '../../lib/articles';export async function getStaticPaths(){const entries=await publishedArticles();return entries.map(article=>({params:{slug:article.id},props:{article}}))}const {article}=Astro.props;const {Content}=await render(article);
---
<Base title={article.data.title+' | NISHAT INFO HUB'} description={article.data.description} image={article.data.image || undefined} article={true} published={article.data.pubDate.toISOString()} updated={article.data.updatedDate?.toISOString()}><div class="max-w-4xl mx-auto px-4 py-12"><nav aria-label="আপনার অবস্থান" class="text-sm text-slate-500 mb-6"><a href="/">হোম</a> / <a href="/articles/">আর্টিকেল</a> / {article.data.category}</nav><span class="text-cyan font-bold text-sm">{article.data.category}</span><h1 class="text-3xl md:text-5xl font-bold text-navy mt-3 leading-tight">{article.data.title}</h1><p class="text-slate-500 mt-4">প্রকাশ: {article.data.pubDate.toLocaleDateString('bn-BD')} · আপডেট: {(article.data.updatedDate||article.data.pubDate).toLocaleDateString('bn-BD')}</p><p class="text-lg text-slate-600 mt-6">{article.data.description}</p>{article.data.image && <img src={article.data.image} alt="" width="1200" height="675" class="mt-8 w-full rounded-2xl object-cover"/>}<div class="mt-8 bg-white border border-slate-200 rounded-2xl p-6 md:p-10 prose prose-slate max-w-none prose-headings:text-navy"><Content/>{article.data.sourceUrl&&<p><a href={article.data.sourceUrl} rel="noopener noreferrer" target="_blank">মূল উৎস দেখুন ↗</a></p>}{article.data.applyUrl&&<p><a class="inline-block bg-cyan text-white rounded-lg px-5 py-3 no-underline" href={article.data.applyUrl} rel="noopener noreferrer" target="_blank">অফিসিয়াল আবেদন লিংক ↗</a></p>}</div><div class="mt-8 bg-cyan/10 p-5 rounded-xl text-sm text-slate-700">এটি স্বাধীন তথ্যভিত্তিক ওয়েবসাইট। সরকারি নিয়োগ বা বিধিবিধানের ক্ষেত্রে সংশ্লিষ্ট কর্তৃপক্ষের মূল প্রকাশনা অনুসরণ করুন।</div><a class="inline-block mt-8 text-cyan font-bold" href="/articles/">← সব আর্টিকেলে ফিরে যান</a></div></Base>
