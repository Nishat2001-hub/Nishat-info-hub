---
import Base from '../../layouts/Base.astro';import ArticleCard from '../../components/ArticleCard.astro';import {publishedArticles} from '../../lib/articles';import {categories} from '../../data/categories';const articles=await publishedArticles();
---
<Base title="সব আর্টিকেল | NISHAT INFO HUB"><div class="max-w-6xl mx-auto px-4 py-12"><h1 class="text-3xl font-bold text-navy">সব আর্টিকেল</h1><p class="text-slate-500 mt-2">আপনার প্রয়োজনীয় বিষয় খুঁজুন ও বিভাগ বেছে নিন।</p><div class="mt-6 flex flex-col md:flex-row gap-3"><input id="search" type="search" aria-label="লেখা খুঁজুন" placeholder="শিরোনাম বা বিষয় লিখুন..." class="border border-slate-300 rounded-xl px-4 py-3 flex-1"/><select id="category" aria-label="বিভাগ নির্বাচন" class="border border-slate-300 rounded-xl px-4 py-3"><option value="">সব বিভাগ</option>{categories.map(c=><option value={c}>{c}</option>)}</select></div><p id="result-count" role="status" aria-live="polite" class="text-sm text-slate-500 mt-4"></p><p id="empty" class="hidden mt-8 text-slate-500">এই অনুসন্ধানে কোনো লেখা পাওয়া যায়নি।</p><div id="cards" class="grid md:grid-cols-3 gap-6 mt-8">{articles.map(a=><div data-title={a.data.title.toLowerCase()} data-description={a.data.description.toLowerCase()} data-category={a.data.category}><ArticleCard article={a}/></div>)}</div></div><script>function initSearch(){const q=document.querySelector<HTMLInputElement>('#search')!;const c=document.querySelector<HTMLSelectElement>('#category')!;if(!q||!c)return;const cards=[...document.querySelectorAll<HTMLElement>('#cards > div')];const params=new URLSearchParams(location.search);q.value=params.get('q')||'';c.value=params.get('category')||'';function filter(){let n=0;cards.forEach(x=>{const ok=(!c.value||x.dataset.category===c.value)&&(!q.value||((x.dataset.title||'')+' '+(x.dataset.description||'')).includes(q.value.toLowerCase().trim()));x.hidden=!ok;if(ok)n++});const status=document.querySelector('#result-count');if(status)status.textContent=n.toLocaleString('bn-BD')+'টি লেখা পাওয়া গেছে';document.querySelector('#empty')?.classList.toggle('hidden',n>0)}function update(){filter();const url=new URL(location.href);for(const [key,value] of [['q',q.value],['category',c.value]]){if(value)url.searchParams.set(key,value);else url.searchParams.delete(key)}history.replaceState(history.state,'',url)}q.addEventListener('input',update);c.addEventListener('change',update);filter();}document.addEventListener('astro:page-load',initSearch);</script></Base>
