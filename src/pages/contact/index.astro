---
import Base from '../../layouts/Base.astro';
import settings from '../../data/site.json';
const email = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(settings.contactEmail) ? settings.contactEmail : '';
const facebook = /^https:\/\/(www\.)?facebook\.com\//.test(settings.facebookUrl) ? settings.facebookUrl : '';
---
<Base title="যোগাযোগ | NISHAT INFO HUB">
  <div class="max-w-4xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold text-navy">যোগাযোগ</h1>
    <div class="mt-8 bg-white border rounded-2xl p-8 leading-loose">
      {email || facebook ? <><p>মতামত, সংশোধন বা তথ্য জানাতে আমাদের সঙ্গে যোগাযোগ করুন।</p>{email && <p>ইমেইল: <a class="text-cyan underline" href={`mailto:${email}`}>{email}</a></p>}{facebook && <p><a class="text-cyan underline" href={facebook} rel="noopener noreferrer" target="_blank">আমাদের Facebook পেজ ↗</a></p>}</> : <p>যোগাযোগের ইমেইল ও সামাজিক যোগাযোগমাধ্যমের লিংক প্রকাশের আগে সাইট পরিচালনাকারী এখানে যুক্ত করবেন। যোগাযোগের তথ্য এখনও সেট করা হয়নি।</p>}
    </div>
  </div>
</Base>
