---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import {publishedArticles, articlePath} from '../lib/articles';
import CategoryIcon from '../components/CategoryIcon.astro';
import {categories} from '../data/categories';
const articles=await publishedArticles();
const featured=articles.filter(a=>a.data.featured).sort((a,b)=>a.data.featuredOrder-b.data.featuredOrder || b.data.pubDate.getTime()-a.data.pubDate.getTime());
const lead=featured[0] || articles[0];
const trending=articles.filter(a=>a.data.trending && a.id!==lead?.id).slice(0,6);
const hot=trending.length ? trending : articles.filter(a=>a.id!==lead?.id).slice(0,6);
const path=articlePath;

---
<Base title="NISHAT INFO HUB | প্রযুক্তি, চাকরি ও দাপ্তরিক তথ্য">
  <div class="border-b border-slate-200 bg-white"><div class="max-w-6xl mx-auto px-4 py-3 flex items-center gap-3"><span class="shrink-0 bg-rose-600 text-white rounded-md px-3 py-1 text-xs font-bold">সর্বশেষ</span><div class="ticker-window whitespace-nowrap text-sm text-slate-700"><div class="ticker-track flex">{[false,true].map(copy=><span class="ticker-group inline-flex gap-8" aria-hidden={copy ? 'true' : undefined}>{articles.slice(0,6).map(a=><a class="hover:text-cyan" tabindex={copy ? -1 : undefined} href={path(a)}>{a.data.title} <span class="text-slate-300" aria-hidden="true">◆</span></a>)}</span>)}</div></div><button id="ticker-toggle" class="ticker-toggle" aria-pressed="false" type="button" aria-label="সর্বশেষ লেখার চলমান তালিকা থামান বা চালু করুন">থামান</button></div></div>
  <section class="max-w-6xl mx-auto px-4 pt-9 pb-8"><div class="flex items-end justify-between gap-3 mb-6"><div><p class="text-cyan font-bold text-xs tracking-widest uppercase">নির্বাচিত তথ্য · Featured News</p><h1 class="text-3xl md:text-4xl font-bold text-navy mt-1">জানুন আজ, এগিয়ে থাকুন আগামীকাল</h1><p class="text-slate-500 mt-2 text-sm">সরকারি চাকরি, প্রযুক্তি ও দাপ্তরিক কাজ—সহজ বাংলায়।</p></div><a class="hidden sm:block text-cyan font-bold text-sm" href="/articles/">সব লেখা →</a></div>
  {lead ? <div class="grid lg:grid-cols-[1.55fr_1fr] gap-5"><a href={path(lead)} class="group relative min-h-[370px] md:min-h-[440px] rounded-3xl overflow-hidden bg-navy text-white flex items-end shadow-xl"><div class="absolute inset-0 bg-gradient-to-br from-[#132b48] via-[#0a5774] to-[#10243b]"></div>{lead.data.image&&<img src={lead.data.image!} alt="" class="absolute inset-0 w-full h-full object-cover opacity-70" loading="eager" fetchpriority="high"/>}<div class="feature-decoration" aria-hidden="true"></div><div class="absolute inset-0 bg-gradient-to-t from-[#07182f] via-[#07182f]/60 to-transparent"></div><div class="relative p-7 md:p-10"><span class="inline-block rounded-full bg-cyan text-white px-3 py-1 text-xs font-bold">প্রধান প্রতিবেদন · {lead.data.category}</span><h2 class="text-2xl md:text-4xl font-bold leading-tight mt-4 group-hover:text-cyan-200">{lead.data.title}</h2><p class="text-slate-200 mt-3 max-w-xl">{lead.data.description}</p><span class="inline-block mt-5 font-bold text-sm">বিস্তারিত পড়ুন ↗</span></div></a><div class="grid gap-4">{(featured.filter(a=>a.id!==lead.id).slice(0,2).length?featured.filter(a=>a.id!==lead.id).slice(0,2):articles.filter(a=>a.id!==lead.id).slice(0,2)).map(a=><a href={path(a)} class="group rounded-2xl bg-white border border-slate-200 p-6 flex flex-col justify-between hover:shadow-lg transition"><div><span class="text-cyan text-xs font-bold">{a.data.category}</span><h3 class="text-xl font-bold text-navy mt-3 group-hover:text-cyan">{a.data.title}</h3><p class="text-slate-500 text-sm mt-3 line-clamp-2">{a.data.description}</p></div><span class="text-xs text-slate-500 mt-4">বিস্তারিত পড়ুন →</span></a>)}</div></div> : <div class="p-10 rounded-2xl bg-white border">এখনো কোনো প্রকাশিত আর্টিকেল নেই।</div>}
  <p class="text-sm text-slate-500 mt-5">এই লেখাগুলো শিক্ষামূলক গাইড; সরকারি বিজ্ঞপ্তির জন্য মূল উৎস যাচাই করুন।</p></section>
  <section class="max-w-6xl mx-auto px-4 py-10" aria-labelledby="trending-title"><div class="flex justify-between items-center mb-6"><div><span class="text-cyan text-xs font-bold">সম্পাদক নির্বাচিত · Trending News</span><h2 id="trending-title" class="text-2xl md:text-3xl font-bold text-navy">আলোচিত বিষয় ও প্রয়োজনীয় গাইড</h2></div><a href="/articles/" class="text-cyan text-sm font-bold">সব দেখুন →</a></div><div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">{hot.map(a=><ArticleCard article={a}/>)}</div></section>
  <section class="bg-white border-y border-slate-200"><div class="max-w-6xl mx-auto px-4 py-12"><div class="flex justify-between items-center mb-6"><h2 class="text-2xl font-bold text-navy">বিষয়ভিত্তিক বিভাগ</h2><a href="/categories/" class="text-cyan font-bold text-sm">সব বিভাগ →</a></div><div class="grid grid-cols-2 md:grid-cols-4 gap-4">{categories.map(c=><a href={'/articles/?category='+encodeURIComponent(c)} class="border border-slate-200 rounded-2xl p-5 hover:border-cyan hover:shadow-md transition"><CategoryIcon category={c} class="h-9 w-9 text-cyan"/><h3 class="font-bold text-navy mt-3">{c}</h3><span class="text-slate-400 text-xs mt-2 block">বিস্তারিত দেখুন →</span></a>)}</div></div></section>
  <section class="max-w-6xl mx-auto px-4 py-12"><div class="flex justify-between items-center mb-6"><h2 class="text-2xl font-bold text-navy">সর্বশেষ প্রকাশনা</h2><a href="/articles/" class="text-cyan font-bold text-sm">সব লেখা →</a></div><div class="grid md:grid-cols-3 gap-5">{articles.slice(0,6).map(a=><ArticleCard article={a}/>)}</div></section>
</Base>
