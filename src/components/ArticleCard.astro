---
import type { Article } from '../lib/articles';
import CategoryIcon from './CategoryIcon.astro';
interface Props { article: Article }
const { article } = Astro.props;
const a = article.data;
---
<a href={'/articles/'+article.id+'/'} class="group bg-white rounded-2xl border border-slate-200 overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all block h-full">
  <div class="article-art h-36 relative overflow-hidden flex items-center px-7 text-white">
    {a.image ? <img src={a.image} alt="" loading="lazy" width="640" height="360" class="absolute inset-0 w-full h-full object-cover"/> : <><div class="art-orbit" aria-hidden="true"></div><CategoryIcon category={a.category} class="relative w-14 h-14"/><div aria-hidden="true" class="art-lines"><span></span><span></span><span></span></div><span class="art-brand" aria-hidden="true">N.</span></>}
  </div>
  <div class="p-5">
    <span class="text-cyan text-xs font-bold">{a.category}</span>
    <h3 class="font-bold text-navy text-lg mt-2 leading-snug group-hover:text-cyan">{a.title}</h3>
    <p class="text-slate-500 text-sm mt-2 line-clamp-2">{a.description}</p>
    <time datetime={a.pubDate.toISOString()} class="inline-block mt-4 text-xs text-slate-500">{a.pubDate.toLocaleDateString('bn-BD')}</time>
  </div>
</a>
